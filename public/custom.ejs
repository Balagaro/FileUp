    let paymentsClient;

    function onGooglePayLoaded() {
        let currentPaymentDataRequest; // A paymentDataRequest változó tárolására.
        paymentsClient = new google.payments.api.PaymentsClient({
            environment: 'TEST',
            paymentDataCallbacks: {
                onPaymentAuthorized: function(paymentData) {
                    console.log('dejooo');
                    return new Promise(function(resolve, reject) {
                        // ...
                    });
                },
                onPaymentDataChanged: function(intermediatePaymentData) {
                    console.log('Fizetési adatok megváltoztak:', intermediatePaymentData);
                    return new Promise(function(resolve, reject) {
                        try {
                            let updatedTransactionInfo = { ...currentPaymentDataRequest.transactionInfo }; // Használjuk a tárolt paymentDataRequest-et

                            if (intermediatePaymentData.shippingAddress) {
                                console.log('Új szállítási cím:', intermediatePaymentData.shippingAddress);
                                if (intermediatePaymentData.shippingAddress.postalCode.startsWith('1')) {
                                    updatedTransactionInfo.totalPrice = '12.00';
                                } else {
                                    updatedTransactionInfo.totalPrice = '10.00';
                                }
                            }

                            if (intermediatePaymentData.shippingOption) {
                                console.log('Kiválasztott szállítási opció:', intermediatePaymentData.shippingOption.id);
                                if (intermediatePaymentData.shippingOption.id === 'express') {
                                    updatedTransactionInfo.totalPrice = (parseFloat(updatedTransactionInfo.totalPrice) + 5.00).toFixed(2);
                                }
                            }

                            resolve({
                                newTransactionInfo: updatedTransactionInfo
                            });
                        } catch (error) {
                            console.error('Hiba a onPaymentDataChanged függvényben:', error);
                            reject({
                                error: {
                                    reason: 'INTERNAL_DEVELOPER_ERROR',
                                    message: 'Hiba történt a fizetési adatok frissítésekor.',
                                    intent: intermediatePaymentData.shippingAddress ? 'SHIPPING_ADDRESS' : 'SHIPPING_OPTION'
                                }
                            });
                        }
                    });
                },
                onPaymentCancelled: function() {
                    // ...
                },
                onError: function(error) {
                    // ...
                }
            }
        });

        const isReadyToPayRequest = {
            apiVersion: 2,
            apiVersionMinor: 0,
            allowedPaymentMethods: [
                {
                    type: 'CARD',
                    parameters: {
                        allowedAuthMethods: ['PAN_ONLY', 'CRYPTOGRAM_3DS'],
                        allowedCardNetworks: ['AMEX', 'DISCOVER', 'JCB', 'MASTERCARD', 'VISA'],
                    },
                    tokenizationSpecification: {
                        type: 'PAYMENT_GATEWAY',
                        parameters: {
                            gateway: 'stripe',
                            stripeVersion: '2020-08-27',
                            publishableKey: 'your-publishable-key',
                        },
                    },
                }
            ],
        };

        paymentsClient.isReadyToPay(isReadyToPayRequest)
            .then(function(response) {
                if (response.result) {
                    createAndAddButton();
                } else {
                    console.log('Google Pay is not available on this device.');
                }
            })
            .catch(function(error) {
                console.error('Error checking Google Pay readiness:', error);
            });

        function handlePayment() {
            currentPaymentDataRequest = {
                apiVersion: 2,
                apiVersionMinor: 0,
                merchantInfo: {
                    merchantId: 'BCR2DN4T26B2VVCN',
                    merchantName: 'Táncsics Teaház',
                },
                allowedPaymentMethods: [
                    {
                        type: 'CARD',
                        parameters: {
                            allowedAuthMethods: ['PAN_ONLY', 'CRYPTOGRAM_3DS'],
                            allowedCardNetworks: ['AMEX', 'DISCOVER', 'JCB', 'MASTERCARD', 'VISA'],
                        },
                        tokenizationSpecification: {
                            type: 'PAYMENT_GATEWAY',
                            parameters: {
                                gateway: 'stripe',
                                stripeVersion: '2020-08-27',
                                publishableKey: 'pk_test_51RD0lcKdDFtfHQ0YFGNwQtddDPijWcsQskrgCuFSE0RkjIzv2stkaO9Xg9jn7EBAKK6FVnkhUbarVaa7gkyO9BE100n5VhfPCi',
                            },
                        },
                    }
                ],
                transactionInfo: {
                    totalPriceStatus: 'FINAL',
                    totalPrice: '10.00',
                    currencyCode: 'HUF',
                    countryCode: 'HU'
                },
                shippingAddressRequired: true,
                shippingOptionRequired: true,
                callbackIntents: ['PAYMENT_AUTHORIZATION', 'SHIPPING_ADDRESS', 'SHIPPING_OPTION']
            };

            paymentsClient.loadPaymentData(currentPaymentDataRequest)
                .then(function(paymentData) {
                    console.log('Payment data loaded successfully:', paymentData);
                })
                .catch(function(error) {
                    console.error('Error during payment:', error);
                });
        }
        function createAndAddButton() {
            const paymentButton = paymentsClient.createButton({
                onClick: handlePayment,
                buttonColor: 'default',
                buttonType: 'buy',
                buttonSizeMode: 'standard',
            });

            const buttonContainer = document.getElementById('google-pay-button');
            if (buttonContainer) {
                buttonContainer.appendChild(paymentButton);
            } else {
                console.error('Element with ID "google-pay-button" not found.');
            }
        }
